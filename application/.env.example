PORT=3000
DATABASE_URL=postgresql://postgres:<set-local-database-password>@localhost:5432/devsecops_study
JWT_SECRET=<generate-a-random-value-of-at-least-32-characters>
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000

# Explicitly non-production seed credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<set-a-local-seed-admin-password>
SEED_USER_PASSWORD=<set-a-local-seed-user-password>
