# Local Docker Compose values only. Copy to .env, which is gitignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-a-local-database-password>
POSTGRES_DB=devsecops_study
POSTGRES_HOST_PORT=5433
JWT_SECRET=<generate-a-random-value-of-at-least-32-characters>
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
API_HOST_PORT=3000
